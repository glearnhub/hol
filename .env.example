# This site is static and reads its settings from js/config.js (there is no
# server-side environment). The values are listed here for reference only.
#
# Find them in Supabase: Project Settings -> API
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=YOUR-PUBLIC-ANON-KEY

# NEVER put the service_role key in this project or on the website.
